# Vertex AI
GOOGLE_GENAI_USE_VERTEXAI=1
GOOGLE_CLOUD_PROJECT=your-gcp-project
GOOGLE_CLOUD_LOCATION=us-central1

# Sentry. Read at runtime; never commit a real value.
SENTRY_AUTH_TOKEN=

# Databricks. The OAuth client id/secret are NOT set here - they are read from
# GCP Secret Manager at client construction (secrets: databricks-client-id,
# databricks-client-secret). Only the non-secret coordinates live in env.
DATABRICKS_WORKSPACE_URL=https://0000000000000000.1.gcp.databricks.com
DATABRICKS_WAREHOUSE_ID=your-warehouse-id
