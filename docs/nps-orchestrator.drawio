        <mxCell id="dbclient" value="databricks_client.py&#xa;OAuth client-credentials, token cache&#xa;(300s pre-expiry margin)&#xa;submit → poll → materialize rows&#xa;every value bound as :named param" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="70" y="470" width="230" height="90" as="geometry" />
        </mxCell>
        <mxCell id="mcpclient" value="hand-rolled MCP client&#xa;JSON-RPC 2.0 over requests&#xa;initialize → notifications/initialized&#xa;→ tools/call; session cached in-process&#xa;&lt;i&gt;exists because McpToolset won't pickle&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="330" y="470" width="240" height="90" as="geometry" />
